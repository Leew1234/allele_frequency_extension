# Configuration for run_plan.sh on 1000 Genomes high-coverage data, GRCh38.
# Copy to plan.env and fill in the paths. Chromosomes are named by RefSeq
# accession (the GFF / FASTA names); CHR_MAP maps them to the VCF/BED/DNM names.

WORK=/scratch/$USER/af_plan                         # all outputs go here
FASTA=/path/GRCh38_latest_genomic.fna                # RefSeq names (NC_...), as in the original repo
GFF=/path/GRCh38_latest_genomic.gff
CHR_MAP=$(dirname "${BASH_SOURCE[0]}")/chr_map_grch38_refseq.tsv
VCF_TEMPLATE=/path/1kGP_high_coverage_Illumina.{contig}.filtered.SNV_INDEL_SV_phased_panel.vcf.gz
SAMPLES=                                             # empty = all 3,202 samples, as the original repo used;
                                                     # a 2,504-unrelated list is a sensitivity analysis
CALLABLE_BED=/path/20160622.allChr.mask.bed          # 1kGP strict accessibility mask (chr names)
PHASTCONS_BED=/path/phastConsElements100way.bed      # UCSC hg38, 3 columns: chrom start end
PHASTCONS_PAD=100                                    # mask B excludes conserved elements +/- this many bp
MAF_THRESHOLD=0.01
INDEL_MODE=original          # labeled span identical to the original repo (anchor | span | original)
KEEP_NON_PASS=1              # the original repo ignored FILTER; 0 = failed records become -1
UNIT_SITES=2000              # unit size for the P2 discrimination endpoint

# Original paper model (per half). Calibrated and uncalibrated predictions,
# files named <seqid>.pred.npy. Half 1 = trained on odd chromosomes
# (base_excludeN_final_extrapolate), half 2 = even (..._theotherhalf_...).
HALF1_ORIG_DIR=/path/calibrated_predictions
HALF1_ORIG_RAW_DIR=/path/polymorphism-main/code_halftrainmaskmissing/base_excludeN_final_extrapolate
HALF2_ORIG_DIR=/path/calibrated_predictions
HALF2_ORIG_RAW_DIR=/path/polymorphism-main/code_halftrainmaskmissing/base_excludeN_final_theotherhalf_extrapolate
ORIG_LABEL_DIR=/path/polymorphism-main/data          # <seqid>_label.pkl, for compare_labels.py (optional)

# De novo mutation sets on GRCh38: space-separated name=path pairs; each file is
# tab-separated chrom and 1-based pos (prepare_dnm.py makes these).
# iceland_2017 (Jonsson et al. 2017, Nature 549:519; 108,778 DNMs on hg38, no
# stated access restriction) is the set the criteria require (G1, G2). Other
# sets are scored descriptively, e.g. denovo_db=... (the paper's SSC siblings;
# its use is limited to autism-related research, and its positions are hg19, so
# lift them over first) or platinum=... (Platinum Pedigree).
DNM_SETS="iceland_2017=/path/dnm/jonsson2017.grch38.tsv"
DNM_NEG_SITES=5000000

# Chromosome roles. chr1 and chr2 are calibration-only: the original repo
# writes both halves' chr1/chr2 predictions to the same folder.
HALF1_TRAIN="NC_000003.12 NC_000005.10 NC_000007.14 NC_000009.12 NC_000011.10 NC_000013.11 NC_000015.10 NC_000017.11 NC_000019.10"
HALF1_VAL="NC_000021.9"
HALF1_CAL="NC_000001.11"
HALF1_TEST="NC_000004.12 NC_000006.12 NC_000008.11 NC_000010.11 NC_000012.12 NC_000014.9 NC_000016.10 NC_000018.10 NC_000020.11 NC_000022.11"
HALF1_SEED_TEST="NC_000004.12 NC_000006.12 NC_000008.11"
HALF2_TRAIN="NC_000004.12 NC_000006.12 NC_000008.11 NC_000010.11 NC_000012.12 NC_000014.9 NC_000016.10 NC_000018.10 NC_000020.11"
HALF2_VAL="NC_000022.11"
HALF2_CAL="NC_000002.12"
HALF2_TEST="NC_000003.12 NC_000005.10 NC_000007.14 NC_000009.12 NC_000011.10 NC_000013.11 NC_000015.10 NC_000017.11 NC_000019.10 NC_000021.9"
HALF2_SEED_TEST="NC_000003.12 NC_000005.10 NC_000007.14"
VALIDATE_SEQIDS="NC_000001.11 NC_000002.12"

HALVES="half1 half2"
SEEDS="0 1 2 3 4"
TRAIN_ARGS=""                                        # defaults follow the paper (2048 bp, 50 x 1000 steps)
