# SLURM settings for submit_plan.sh (University of Michigan Great Lakes or any
# SLURM cluster). Copy to slurm.env and edit. Check partition names and limits
# with `sinfo` and your account with `my_accounts`; find modules with
# `module spider bcftools` / `module spider tensorflow`.

ACCOUNT=your_account                 # e.g. your PI's or class account
PARTITION_CPU=standard
PARTITION_GPU=gpu                    # or spgpu
GPUS_PER_JOB=1

# Commands run at the start of every job: load bcftools and a Python with
# NumPy + TensorFlow >= 2.13 (tested with 2.21 / Keras 3; the original repo's
# tensorflow/2.7.0 module is too old for the .keras model format).
SETUP_CMD='module load Bioinformatics bcftools; source $HOME/venvs/af/bin/activate'

# Resources per stage (hours:minutes:seconds). Generous first guesses: check
# the pilot's actual use with `seff <jobid>` and adjust before the full run.
PREP_TIME=24:00:00;   PREP_MEM=64G;   PREP_CPUS=4      # labels, masks, label validation
TRAIN_TIME=12:00:00;  TRAIN_MEM=64G;  TRAIN_CPUS=4     # one model per array task
PREDICT_TIME=24:00:00; PREDICT_MEM=48G; PREDICT_CPUS=4 # one (half, configuration) per task
POST_TIME=12:00:00;   POST_MEM=64G;   POST_CPUS=4      # scoring, de novo, criteria report

MAIL_USER=                           # optional: your email for END/FAIL notices
