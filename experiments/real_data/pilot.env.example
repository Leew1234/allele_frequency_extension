# Pilot: one half, small chromosomes, 2 seeds -- checks real-data paths, labels,
# chromosome mapping and compute before the full run. Criteria that need half 2
# or seeds 2-4 will show MISSING; that is expected and the pilot is not
# interpreted scientifically.
source "$(dirname "${BASH_SOURCE[0]}")/plan.env"     # reuse paths from your filled-in plan.env
WORK=${WORK}_pilot
HALVES="half1"
HALF1_TRAIN="NC_000017.11 NC_000019.10"
HALF1_VAL="NC_000021.9"
HALF1_CAL="NC_000001.11"
HALF1_TEST="NC_000020.11 NC_000022.11"
HALF1_SEED_TEST="NC_000022.11"
VALIDATE_SEQIDS="NC_000001.11"
SEEDS="0 1"
