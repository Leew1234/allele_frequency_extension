# Configuration for run_spectrum.sh (analysis plan v2: frequency-spectrum classes).
# Copy to spectrum.env and fill in. It starts from your v1 plan.env, so the
# reference genome, annotation, masks' sources, chromosome roles and de novo
# sets are the same; only what differs is set here.

source "$(dirname "${BASH_SOURCE[0]}")/../real_data/plan.env"

V1_WORK=$WORK                    # the finished v1 run, if it is on this machine: its one-hot
                                 # DNA arrays are reused (set to "" if there is none)
WORK=${WORK}_spectrum            # all v2 outputs go here

# Variants come from the FULL call set (fetch_fullcallset.sh), not the phased
# panel of v1: the phased panel has no singletons.
FULL_SITES_TEMPLATE=/path/sites_full/{contig}.sites.vcf.gz
FULL_TABLE_TEMPLATE=/path/sites_full/{contig}.bcftools.tsv   # for the validate step
VALIDATE_SEQIDS="NC_000022.11"   # chromosomes with a bcftools table (small ones are enough)

# Class definitions. Common keeps the v1 frequency boundary; the others are counts.
MAF_THRESHOLD=0.01
COUNT_BINS="1 5"                 # singleton = 1 copy, ultra-rare = 2-5, rare = 6 copies up to 1%
SNV_ONLY=1                       # 1 = SNVs only; bases under indel/MNP records are ignored
KEEP_NON_PASS=0                  # 0 = records failing VQSR or the missingness filter are ignored sites

SPECTRUM_CONFIGS="neutralAB"     # neutral set the model is trained and calibrated on: neutralAB =
                                 # unannotated AND outside conserved elements (default); neutralA =
                                 # unannotated only (v1's "neutral"); neutralB = outside conserved
                                 # elements only. List several to run them all.
KMER_K="3 7"                     # context baselines; the first (trinucleotide) is the pre-specified one
MUT_BINS=10
SEEDS="0 1 2 3 4"
SEED_PREDICTIONS=1               # also predict and score each seed alone on HALFn_SEED_TEST
TRAIN_ARGS=""

# De novo benchmark: the original OVEP predictions (HALFn_ORIG_DIR / _RAW_DIR
# from plan.env) are used if set. Optionally also the v1 neutral model:
V1_PRED_TEMPLATE=""              # e.g. $V1_WORK/pred/{half}/neutral/{seqid}.npy
